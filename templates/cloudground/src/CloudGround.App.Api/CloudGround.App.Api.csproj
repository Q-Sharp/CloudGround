<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <PackageReference Include="Aspire.Keycloak.Authentication" />
    <PackageReference Include="Aspire.StackExchange.Redis.DistributedCaching" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="WolverineFx.EntityFrameworkCore" />
    <PackageReference Include="WolverineFx.Postgresql" />
    <PackageReference Include="WolverineFx.RabbitMQ" />
    <PackageReference Include="WolverineFx.RuntimeCompilation" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CloudGround.App.Api.Tests" />
  </ItemGroup>

  <ItemGroup Condition="'$(WolverineCodeGenerated)' != 'true'">
    <Compile Remove="Internal/Generated/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../CloudGround.App.ServiceDefaults/CloudGround.App.ServiceDefaults.csproj" />
    <!--#if (sample) -->
    <ProjectReference Include="../Modules/CloudGround.App.Modules.Projects/CloudGround.App.Modules.Projects.csproj" />
    <ProjectReference Include="../Modules/CloudGround.App.Modules.Tasks/CloudGround.App.Modules.Tasks.csproj" />
    <!--#endif -->
  </ItemGroup>

  <Target Name="GenerateWolverineCode" AfterTargets="Build" Condition="'$(_IsPublishing)' == 'true' and '$(WolverineCodeGenerated)' != 'true'">
    <RemoveDir Directories="$(MSBuildProjectDirectory)/Internal/Generated" />
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; &quot;$(TargetPath)&quot; codegen write" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Build" Properties="WolverineCodeGenerated=true" />
  </Target>

  <Target Name="RequireBuildForWolverineCode" BeforeTargets="PrepareForPublish" Condition="'$(NoBuild)' == 'true'">
    <Error Text="$(MSBuildProjectName) cannot be published with --no-build, because Wolverine generates its handler code from the built API during publish." />
  </Target>

</Project>
