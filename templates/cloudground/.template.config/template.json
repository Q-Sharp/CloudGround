{
  "$schema": "http://json.schemastore.org/template",
  "author": "Q-Sharp",
  "classifications": [
    "Web",
    "Aspire",
    "Cloud",
    "Solution"
  ],
  "identity": "CloudGround.Templates.Solution",
  "name": "CloudGround",
  "shortName": "cloudground",
  "description": "Container-based .NET solution with Aspire, a modular monolith and a visible architecture.",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "sources": [
    {
      "modifiers": [
        {
          "exclude": [
            "**/bin/**",
            "**/obj/**",
            "**/.vs/**",
            "**/*.user"
          ]
        }
      ]
    }
  ],
  "guids": [
    "9193ce95-4777-4b80-b4af-2eb5f52325f6"
  ],
  "forms": {
    "namespaceSafe": {
      "identifier": "replace",
      "pattern": "(((?<=\\.)|^)(?=\\d)|[^\\w.])",
      "replacement": "_"
    },
    "classNameSafe": {
      "identifier": "replace",
      "pattern": "(((?<=\\.)|^)(?=\\d)|\\W)",
      "replacement": "_"
    }
  },
  "symbols": {
    "solutionNamespace": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "namespaceSafe",
      "replaces": "CloudGround.App",
      "fileRename": "CloudGround.App"
    },
    "solutionClassNamePrefix": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "classNameSafe",
      "replaces": "CloudGround_App"
    }
  }
}
