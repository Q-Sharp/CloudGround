{
  "$schema": "http://json.schemastore.org/template",
  "author": "Q-Sharp",
  "classifications": [
    "Web",
    "Aspire",
    "Cloud",
    "Solution"
  ],
  "identity": "CloudGround.Templates.Solution",
  "name": "CloudGround",
  "shortName": "cloudground",
  "description": "Container-based .NET solution with Aspire, a modular monolith and a visible architecture.",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "sources": [
    {
      "modifiers": [
        {
          "exclude": [
            "**/bin/**",
            "**/obj/**",
            "**/.vs/**",
            "**/*.user"
          ]
        },
        {
          "condition": "(!sample)",
          "exclude": [
            "src/Modules/**",
            "tests/CloudGround.App.Modules.*/**",
            "tests/CloudGround.App.Integration.Tests/Projects*.cs",
            "tests/CloudGround.App.Integration.Tests/Tasks*.cs",
            "tests/CloudGround.App.Integration.Tests/ProjectArchived*.cs",
            "tests/CloudGround.App.Integration.Tests/ModuleAssertions.cs"
          ]
        }
      ]
    }
  ],
  "guids": [
    "9193ce95-4777-4b80-b4af-2eb5f52325f6"
  ],
  "forms": {
    "namespaceSafe": {
      "identifier": "replace",
      "pattern": "(((?<=\\.)|^)(?=\\d)|[^\\w.])",
      "replacement": "_"
    },
    "classNameSafe": {
      "identifier": "replace",
      "pattern": "(((?<=\\.)|^)(?=\\d)|\\W)",
      "replacement": "_"
    }
  },
  "symbols": {
    "sample": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Include the Projects and Tasks sample modules."
    },
    "solutionNamespace": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "namespaceSafe",
      "replaces": "CloudGround.App",
      "fileRename": "CloudGround.App"
    },
    "solutionClassNamePrefix": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "classNameSafe",
      "replaces": "CloudGround_App"
    },
    "appHostHttpsPort": {
      "type": "generated",
      "generator": "port",
      "parameters": {
        "low": 17000,
        "high": 17300
      },
      "replaces": "17297"
    },
    "appHostHttpPort": {
      "type": "generated",
      "generator": "port",
      "parameters": {
        "low": 15000,
        "high": 15300
      },
      "replaces": "15295"
    },
    "dashboardOtlpHttpsPort": {
      "type": "generated",
      "generator": "port",
      "parameters": {
        "low": 21000,
        "high": 21300
      },
      "replaces": "21032"
    },
    "dashboardOtlpHttpPort": {
      "type": "generated",
      "generator": "port",
      "parameters": {
        "low": 19000,
        "high": 19300
      },
      "replaces": "19218"
    },
    "resourceServiceHttpsPort": {
      "type": "generated",
      "generator": "port",
      "parameters": {
        "low": 22000,
        "high": 22300
      },
      "replaces": "22029"
    },
    "resourceServiceHttpPort": {
      "type": "generated",
      "generator": "port",
      "parameters": {
        "low": 20000,
        "high": 20300
      },
      "replaces": "20215"
    },
    "apiHttpsPort": {
      "type": "generated",
      "generator": "port",
      "parameters": {
        "low": 7000,
        "high": 7300
      },
      "replaces": "7311"
    },
    "apiHttpPort": {
      "type": "generated",
      "generator": "port",
