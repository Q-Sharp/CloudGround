<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>CloudGround.Templates</PackageId>
    <Title>CloudGround</Title>
    <Authors>Q-Sharp</Authors>
    <Description>dotnet new template for container-based .NET solutions with Aspire, Angular and a visible architecture.</Description>
    <PackageTags>dotnet-new;templates;aspire;angular;modular-monolith</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Q-Sharp/CloudGround</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Q-Sharp/CloudGround</RepositoryUrl>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeContentInPack>true</IncludeContentInPack>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <EnableDefaultItems>false</EnableDefaultItems>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="templates/**/*" Exclude="templates/**/bin/**;templates/**/obj/**;templates/**/.vs/**;templates/**/*.user;templates/**/node_modules/**;templates/**/dist/**;templates/**/.angular/**" />
    <None Include="docs/nuget/README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
